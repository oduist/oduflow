# ── Server ────────────────────────────────────────────
FLOW_TRANSPORT=http          # http | stdio
FLOW_HOST=0.0.0.0
FLOW_PORT=8000
FLOW_AUTH_TOKEN=             # Bearer token for HTTP auth (empty = auth disabled)

# ── Paths ─────────────────────────────────────────────
FLOW_WORKSPACES_DIR=~/.flow/workspaces
FLOW_DUMP_PATH=~/.flow/odoo_ref.dump
FLOW_REF_FILESTORE_PATH=~/.flow/odoo_ref_filestore

# ── Network / Host ────────────────────────────────────
EXTERNAL_HOST=localhost
PORT_RANGE_START=50000
PORT_RANGE_END=50100

# ── Database ──────────────────────────────────────────
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo
