# ── Server ────────────────────────────────────────────
ODUFLOW_TRANSPORT=http          # http | stdio
ODUFLOW_HOST=0.0.0.0
ODUFLOW_PORT=8000
ODUFLOW_AUTH_TOKEN=             # Bearer token for MCP HTTP auth (empty = auth disabled)
ODUFLOW_UI_PASSWORD=            # Password for Web UI Basic Auth (empty = UI open)

# ── Multi-Instance ────────────────────────────────────
ODUFLOW_INSTANCE_ID=1           # Instance ID (1-9). Default: 1
                                # Use different IDs to run multiple oduflow instances
                                # Each instance has separate DB prefix and ODUFLOW_HOME

# ── Paths ─────────────────────────────────────────────
ODUFLOW_HOME=/srv/oduflow_data_1     # Base directory for instance data (auto-suffixed with instance ID if not set)
# ODUFLOW_WORKSPACES_DIR=       # Default: $ODUFLOW_HOME/workspaces
# Dump folder structure: $ODUFLOW_HOME/dump/dump.sql + $ODUFLOW_HOME/dump/filestore/

# ── Git ────────────────────────────────────────────────
ODUFLOW_DEFAULT_BRANCH=main     # Base branch for new branches that don't exist yet
ODUFLOW_DEFAULT_TEMPLATE=default # Default template profile for new environments

# ── Network / Host ────────────────────────────────────
EXTERNAL_HOST=localhost
PORT_RANGE_START=50000
PORT_RANGE_END=50100

# ── Routing ───────────────────────────────────────────
ODUFLOW_ROUTING_MODE=port          # port | traefik
ODUFLOW_BASE_DOMAIN=               # e.g. dev.example.com (required for traefik)
ODUFLOW_ACME_EMAIL=                # Let's Encrypt email (required for traefik)

# ── Filestore ─────────────────────────────────────────
ODUFLOW_OVERLAY_THRESHOLD_MB=50  # Template filestore size limit (MB) for overlay vs copy.
                                 # Templates smaller than this → simple copy per environment.
                                 # Templates larger → fuse-overlayfs (saves disk space).

# ── Database ──────────────────────────────────────────
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo
