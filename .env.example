# ── Server ────────────────────────────────────────────
FLOW_TRANSPORT=http          # http | stdio
FLOW_HOST=0.0.0.0
FLOW_PORT=8000
FLOW_AUTH_TOKEN=             # Bearer token for HTTP auth (empty = auth disabled)

# ── Paths ─────────────────────────────────────────────
FLOW_HOME=/srv/flow_data     # Base directory for all Flow data
# FLOW_WORKSPACES_DIR=       # Default: $FLOW_HOME/workspaces
# FLOW_DUMP_PATH=            # Default: $FLOW_HOME/odoo_ref.dump
# FLOW_REF_FILESTORE_PATH=   # Default: $FLOW_HOME/odoo_ref_filestore

# ── Git ────────────────────────────────────────────────
FLOW_DEFAULT_BRANCH=prod     # Base branch for new branches that don't exist yet

# ── Network / Host ────────────────────────────────────
EXTERNAL_HOST=localhost
PORT_RANGE_START=50000
PORT_RANGE_END=50100

# ── Routing ───────────────────────────────────────────
FLOW_ROUTING_MODE=port          # port | traefik
FLOW_BASE_DOMAIN=               # e.g. dev.example.com (required for traefik)
FLOW_ACME_EMAIL=                # Let's Encrypt email (required for traefik)

# ── Database ──────────────────────────────────────────
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo
